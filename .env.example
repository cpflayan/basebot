# ═══════════════════════════════════════════════════════════════
# RPC — 鏈上連線
# ═══════════════════════════════════════════════════════════════
# Base (主要鏈) — getSecrets() 透過 RPC_URL_${chainId} 或 RPC_URL_BASE 讀取
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Fallback transport — client/src/index.ts (主 RPC 失敗時自動切換)
FALLBACK_RPC_URL=https://base-mainnet.infura.io/v3/<INFURA_API_KEY>
# Watch blocks — client/src/index.ts (watchBlocks 用免費 RPC 避免 Alchemy rate limit)
WATCH_RPC_URL=https://base-rpc.publicnode.com
# Public/scan RPC — config/src/config.ts (scanRpcUrls fallback, 歷史事件掃描)
PUBLIC_RPC_URL_BASE=https://mainnet.base.org

# Ethereum Mainnet (測試/部署用)
RPC_URL_MAINNET=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# ═══════════════════════════════════════════════════════════════
# Paid RPC — 付費節點 (paidReadClient round-robin + writeClient failover)
# ═══════════════════════════════════════════════════════════════
# paidReadClient 輪值: Chainstack → Coinbase → ZAN → GetBlock → NodeReal
# writeClient failover: Alchemy → Coinbase → Chainstack → ZAN → GetBlock
PAID_RPC_CHAINSTACK=https://base-mainnet.core.chainstack.com/<API_KEY>
PAID_RPC_COINBASE=https://api.developer.coinbase.com/rpc/v1/base/<API_KEY>
PAID_RPC_ZAN=https://api.zan.top/node/v1/base/mainnet/<API_KEY>
PAID_RPC_GETBLOCK=https://shared.us-east-1.getblock.io/<API_KEY>
PAID_RPC_NODEREAL=https://open-platform.nodereal.io/<API_KEY>/base

# ═══════════════════════════════════════════════════════════════
# Executor — 清算合約
# ═══════════════════════════════════════════════════════════════
EXECUTOR_ADDRESS_8453=0xca2bb167a5bf92dc0891088285da48d9e66c0661
# EXECUTOR_ADDRESS_1=0x...  # Ethereum mainnet (可選)

# ═══════════════════════════════════════════════════════════════
# Private Keys — 錢包
# ═══════════════════════════════════════════════════════════════
LIQUIDATION_PRIVATE_KEY_8453=0x<YOUR_PRIVATE_KEY>
# LIQUIDATION_PRIVATE_KEY_1=0x...  # Ethereum mainnet (可選)
# FLASHBOTS_PRIVATE_KEY=0x...      # Flashbots bundle signing (僅 mainnet 需要)

# ═══════════════════════════════════════════════════════════════
# Data — discovery / cache
# ═══════════════════════════════════════════════════════════════
WHITELIST_DATA_DIR=./morpho-liquidation-discovery/data
KILL_SWITCH_PATH=./data/kill.flag

# ═══════════════════════════════════════════════════════════════
# 熔斷參數
# ═══════════════════════════════════════════════════════════════
CIRCUIT_BREAKER_POLL_MS=60000
MAX_DRAWDOWN_PCT=20
MAX_ABSOLUTE_LOSS_NATIVE=0.05

# ═══════════════════════════════════════════════════════════════
# Server Ports
# ═══════════════════════════════════════════════════════════════
WEBHOOK_PORT=3001              # → client/src/script.ts (WebhookServer)
HEALTH_SERVER_PORT=3000        # → client/src/health.ts (health check)
HEALTH_SERVER_HOST=127.0.0.1   # → client/src/health.ts (預設 localhost)

# ═══════════════════════════════════════════════════════════════
# Bot Tuning
# ═══════════════════════════════════════════════════════════════
CACHE_REFRESH_INTERVAL_MS=300000   # → client/src/bot.ts (定期刷新間隔)
MARKET_CACHE_TTL_MS=60000          # → client/src/bot.ts (市場快取過期時間)
LOG_LEVEL=info                     # → client/src/utils/logger.ts (debug/info/warn/error)

# ═══════════════════════════════════════════════════════════════
# Security — 黑名單 (逗號分隔)
# ═══════════════════════════════════════════════════════════════
TOKEN_BLACKLIST=0x4ed4e862860bed51a9570b96d89af5e1b0efefed

# ═══════════════════════════════════════════════════════════════
# 通知（至少填一組，不然熔斷時你不會收到任何訊息）
# ═══════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ═══════════════════════════════════════════════════════════════
# DEX API Keys
# ═══════════════════════════════════════════════════════════════
ONE_INCH_SWAP_API_KEY=<YOUR_1INCH_API_KEY>
# ZERO_EX_API_KEY=<YOUR_ZEROEX_API_KEY>    # → liquidity-venues/src/zeroEx/index.ts
# LIFI_API_KEY=<YOUR_LIFI_API_KEY>         # → liquidity-venues/src/lifi/index.ts
