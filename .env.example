# === RPC ===
RPC_URL_1=https://eth-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
RPC_URL_8453=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>

# === Executor ===
EXECUTOR_ADDRESS_1=0x1234567890123456789012345678901234567890
EXECUTOR_ADDRESS_8453=0x1234567890123456789012345678901234567890
LIQUIDATION_PRIVATE_KEY_1=<YOUR_PRIVATE_KEY>
LIQUIDATION_PRIVATE_KEY_8453=<YOUR_PRIVATE_KEY>

# === Data ===
WHITELIST_DATA_DIR=/path/to/morpho-liquidation-discovery/data

# === Optional ===
# Alchemy Base RPC for fallback scanning
# ALCHEMY_BASE_RPC=https://base-mainnet.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# Token blacklist — comma-separated addresses to skip in liquidations
# TOKEN_BLACKLIST=0x1234...,0x5678...
