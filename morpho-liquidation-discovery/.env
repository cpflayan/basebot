# === RPC（第一階段只需要填 Base，其他先留空即可）===
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/moIm48FL6Bajcm-pRecmw
# 回填雙 RPC：掃描用 Base 官方（支持 10000 區塊 eth_getLogs），安全檢查用 Alchemy
BACKFILL_SCAN_RPC=https://mainnet.base.org
BACKFILL_SAFETY_RPC=https://base-mainnet.g.alchemy.com/v2/moIm48FL6Bajcm-pRecmw
# Base 官方 RPC eth_getLogs 上限 10000 區塊
BACKFILL_BATCH_SIZE=10000
RPC_URL_MAINNET=
RPC_URL_ARBITRUM=
RPC_URL_POLYGON=

# === 官方 bot 的 executor 合約地址（每條鏈各自一組，部署後填入）===
EXECUTOR_ADDRESS_8453=0x1234567890123456789012345678901234567890

# === 共用資料夾（discovery 服務跟官方 bot 的 config patch 要指向同一個路徑）===
WHITELIST_DATA_DIR=./data
KILL_SWITCH_PATH=./data/kill.flag

# === 熔斷參數 ===
CIRCUIT_BREAKER_POLL_MS=60000
MAX_DRAWDOWN_PCT=20
MAX_ABSOLUTE_LOSS_NATIVE=0.05

# === 通知（至少填一組，不然熔斷時你不會收到任何訊息）===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# === 1inch Swap API（流動性檢查兜底）===
ONE_INCH_SWAP_API_KEY=u85RSYYzIox5Sk5ZfZfHayGDBiXBTJy9
